    cloud_parser.add_argument("--host", help="SSH host alias for the AWS Mac")
    cloud_parser.add_argument("--device", help="Simulator device (e.g., 'iPhone 16 Pro')")
    cloud_parser.add_argument("--branch", help="Branch name (default: current git branch)")
    cloud_parser.add_argument("--no-push", action="store_true", help="Skip file sync")
    cloud_parser.add_argument("--no-build", action="store_true", help="Skip build step")
    cloud_parser.set_defaults(func=cmd_cloud, cloud_command=None)

    cloud_sub = cloud_parser.add_subparsers(dest="cloud_command")

    cloud_push = cloud_sub.add_parser("push", help="Sync project files to remote")
    cloud_push.set_defaults(func=cmd_cloud)

    cloud_build = cloud_sub.add_parser("build", help="Run build on remote")
    cloud_build.set_defaults(func=cmd_cloud)

    cloud_sim = cloud_sub.add_parser("sim", help="Boot simulator and stream")
    cloud_sim.set_defaults(func=cmd_cloud)

    cloud_list = cloud_sub.add_parser("list", help="List active sessions")
    cloud_list.set_defaults(func=cmd_cloud)

    cloud_kill = cloud_sub.add_parser("kill", help="Destroy a session")
    cloud_kill.add_argument("session_id", nargs="?", help="Session ID to destroy")
    cloud_kill.add_argument("--all", action="store_true", help="Destroy all sessions")
    cloud_kill.set_defaults(func=cmd_cloud)

    cloud_setup = cloud_sub.add_parser("setup", help="Show server setup instructions")
    cloud_setup.set_defaults(func=cmd_cloud)

    args, remaining = parser.parse_known_args()

    if not args.command:
        parser.print_help()
        sys.exit(1)

    # Pass remaining unknown args as build_args for iosbuild
    if args.command == "iosbuild":
        args.build_args = remaining
    elif remaining:
        parser.error(f"unrecognized arguments: {' '.join(remaining)}")

    args.func(args)


if __name__ == "__main__":
    main()
