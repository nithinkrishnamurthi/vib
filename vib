def cmd_cloud_full(args):
    """Handle 'vib cloud' (no subcommand) — full pipeline."""
    host = args._cloud_host
    config = args._cloud_config

    project = os.path.basename(os.getcwd())
    branch = args.branch if hasattr(args, "branch") and args.branch else (get_git_branch() or "main")
    device = args.device if hasattr(args, "device") and args.device else config["device"]
    no_push = hasattr(args, "no_push") and args.no_push
    no_build = hasattr(args, "no_build") and args.no_build

    # Step 1: Create session (boots simulator headlessly)
    print(f"[1/4] Creating simulator session ({device})...")
    response = cloud_api_request(host, "POST", "/api/sessions", {
        "project": project,
        "branch": branch,
        "device": device,
        "build_command": config.get("build_command"),
        "runtime": config.get("runtime"),
    }, timeout=60)

    if response.get("status") != "ok":
        print(f"Error: {response.get('message', 'Failed to create session')}", file=sys.stderr)
        sys.exit(1)

    session = response["session"]
    session_id = session["id"]
    print(f"  Session: {session_id}")
    print(f"  Simulator: {session['sim_device']} ({session['sim_udid']})")

    # Step 2: Upload project files to the session
    if not no_push:
        print(f"[2/4] Uploading project...")
        zip_data = cloud_zip_project()
        success, message = cloud_upload_to_session(host, session_id, zip_data)
        if not success:
            print(f"Error: {message}", file=sys.stderr)
            sys.exit(1)
        print(f"  {message}")
    else:
        print("[2/4] Skipping upload (--no-push)")

    # Step 3: Build
    if not no_build:
        print(f"[3/4] Building...")
        build_response = cloud_api_request(host, "POST", f"/api/sessions/{session_id}/build", {
            "command": config.get("build_command"),
        }, timeout=600)

        if build_response.get("build_success"):
            print("  Build succeeded!")
        else:
            print(f"  Build failed: {build_response.get('message', '')}", file=sys.stderr)
            output = build_response.get("output", "")
            if output:
                lines = output.strip().split("\n")
                for line in lines[-50:]:
                    print(f"  {line}")
            print("  Continuing to stream simulator despite build failure...")
    else:
        print("[3/4] Skipping build (--no-build)")

    # Step 4: Open browser
    print(f"[4/4] Opening browser...")
    _run_cloud_viewer(host, session)


def _run_cloud_viewer(host, session):
    """Open the browser viewer and block until Ctrl+C."""
    session_id = session["id"]

    url = f"{cloud_base_url(host)}/sessions/{session_id}/"

    import webbrowser
    try:
        webbrowser.open(url)
        print(f"  Opened: {url}")
    except Exception:
        print(f"  Open in browser: {url}")

    print(f"\nSession {session_id} is live. Press Ctrl+C to stop.")

    stop_event = threading.Event()

    def handle_signal(signum, frame):
        stop_event.set()

    signal.signal(signal.SIGINT, handle_signal)
    signal.signal(signal.SIGTERM, handle_signal)

    try:
        while not stop_event.is_set():
            time.sleep(1)
    except KeyboardInterrupt:
        pass
    finally:
        print("\nCleaning up...")
        print(f"Destroying session {session_id}...")
        cloud_api_request(host, "DELETE", f"/api/sessions/{session_id}")
        print("Done.")


