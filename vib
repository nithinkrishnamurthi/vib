def cloud_zip_project():
    """Zip the current project directory.

    Uses `git archive` if in a git repo (respects .gitignore automatically),
    otherwise falls back to zipfile with manual exclusions.

    Returns:
        bytes (zip data)
    """
    import io
    import zipfile

    cwd = os.getcwd()

    # Try git archive first — cleanest, respects .gitignore
    try:
        result = subprocess.run(
            ["git", "archive", "--format=zip", "HEAD"],
            capture_output=True, cwd=cwd, timeout=60,
        )
        if result.returncode == 0 and result.stdout:
            return result.stdout
    except Exception:
        pass

    # Fallback: build zip manually
    zip_buf = io.BytesIO()
    exclude = {".git", "__pycache__", ".DS_Store", "node_modules", ".venv", "venv"}
    with zipfile.ZipFile(zip_buf, "w", zipfile.ZIP_DEFLATED) as zf:
        for root, dirs, files in os.walk(cwd):
            dirs[:] = [d for d in dirs if d not in exclude]
            for f in files:
                if f.endswith(".pyc"):
                    continue
                full = os.path.join(root, f)
                arc = os.path.relpath(full, cwd)
                zf.write(full, arc)
    return zip_buf.getvalue()


CLOUD_SERVER_PORT = 8500


def cloud_base_url(host):
    """Return the base URL for the cloud server."""
    return f"http://{host}:{CLOUD_SERVER_PORT}"


def cloud_upload_to_session(host, session_id, zip_data):
    """Upload a zip file to a specific session on the cloud server.

    Returns:
        (success, message) tuple
    """
    import urllib.request
    import urllib.error

    size_mb = len(zip_data) / (1024 * 1024)
    url = f"{cloud_base_url(host)}/api/sessions/{session_id}/upload"
    req = urllib.request.Request(
        url, data=zip_data, method="POST",
        headers={"Content-Type": "application/zip"},
    )

    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            result = json.loads(resp.read())
            if result.get("status") == "ok":
                return (True, f"Uploaded {size_mb:.1f} MB → {result.get('project_dir', '?')}")
            return (False, result.get("message", "Upload failed"))
    except urllib.error.HTTPError as e:
        try:
            body = json.loads(e.read())
            return (False, body.get("message", f"HTTP {e.code}"))
        except Exception:
            return (False, f"HTTP {e.code}: {e.reason}")
    except urllib.error.URLError as e:
        return (False, f"Connection failed: {e.reason}")
    except Exception as e:
        return (False, str(e))


def cloud_api_request(host, method, path, data=None, timeout=30):
    """Send an HTTP request to the vib-cloud-server.

    Args:
        host: Cloud server hostname/IP
        method: HTTP method (GET, POST, DELETE)
        path: API path (e.g., "/api/sessions")
        data: JSON body for POST requests (dict)
        timeout: Request timeout in seconds

    Returns:
        Response dict from the server
    """
    import urllib.request
    import urllib.error

    url = f"{cloud_base_url(host)}{path}"

    body = json.dumps(data).encode() if data else None
    req = urllib.request.Request(
        url, data=body, method=method,
        headers={"Content-Type": "application/json"} if body else {},
    )

    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        try:
            return json.loads(e.read())
        except Exception:
            return {"status": "error", "message": f"HTTP {e.code}: {e.reason}"}
    except urllib.error.URLError as e:
        return {"status": "error", "message": f"Connection failed: {e.reason}"}
    except Exception as e:
        return {"status": "error", "message": str(e)}


def cmd_cloud(args):
    """Handle 'vib cloud' command — dispatcher."""
    sub = getattr(args, "cloud_command", None)

    # Setup doesn't need a host — it just prints instructions
    if sub == "setup":
        cmd_cloud_setup(args)
        return

    config = get_cloud_config()
    host = args.host if hasattr(args, "host") and args.host else config["host"]

    if not host:
        print("Error: No cloud host specified.", file=sys.stderr)
        print("Set 'cloud_host = yourhost' in ~/.vib/config or use --host", file=sys.stderr)
        sys.exit(1)

    args._cloud_config = config
    args._cloud_host = host

    if sub == "push":
        cmd_cloud_push(args)
    elif sub == "build":
        cmd_cloud_build(args)
    elif sub == "sim":
        cmd_cloud_sim(args)
    elif sub == "list":
        cmd_cloud_list(args)
    elif sub == "kill":
        cmd_cloud_kill(args)
    else:
        cmd_cloud_full(args)


def cmd_cloud_push(args):
    """Handle 'vib cloud push' — create session + upload project files."""
    host = args._cloud_host
    config = args._cloud_config
    project = os.path.basename(os.getcwd())
    branch = args.branch if hasattr(args, "branch") and args.branch else (get_git_branch() or "main")
    device = args.device if hasattr(args, "device") and args.device else config["device"]

    print("Creating session...")
    response = cloud_api_request(host, "POST", "/api/sessions", {
        "project": project,
        "branch": branch,
        "device": device,
        "build_command": config.get("build_command"),
    })
    if response.get("status") != "ok":
        print(f"Error: {response.get('message', 'Failed to create session')}", file=sys.stderr)
        sys.exit(1)

    session_id = response["session"]["id"]
    print(f"Session {session_id} created")

    print("Zipping and uploading project...")
    zip_data = cloud_zip_project()
    success, message = cloud_upload_to_session(host, session_id, zip_data)
    if not success:
        print(f"Error: {message}", file=sys.stderr)
        sys.exit(1)
    print(message)


def cmd_cloud_build(args):
    """Handle 'vib cloud build' — trigger build on remote."""
    host = args._cloud_host
    config = args._cloud_config

    response = cloud_api_request(host, "GET", "/api/sessions")
    if response.get("status") != "ok":
        print(f"Error: {response.get('message', 'Failed to list sessions')}", file=sys.stderr)
        sys.exit(1)

    sess = response.get("sessions", [])
    if not sess:
        print("No active sessions. Run 'vib cloud' first to create one.", file=sys.stderr)
        sys.exit(1)

    session_id = sess[0]["id"]
    build_cmd = config.get("build_command")

    print(f"Building in session {session_id}...")
    response = cloud_api_request(host, "POST", f"/api/sessions/{session_id}/build", {
        "command": build_cmd,
    }, timeout=600)

    if response.get("build_success"):
        print("Build succeeded!")
    else:
        print(f"Build failed: {response.get('message', '')}", file=sys.stderr)
        output = response.get("output", "")
        if output:
            print(output)
        sys.exit(1)


